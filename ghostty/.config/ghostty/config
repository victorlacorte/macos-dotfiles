# https://ghostty.org/docs/config/reference
font-family = JetBrains Mono NL
# font-feature = -liga
# font-feature = -calt
font-size = 16
background-opacity = 0.9
macos-titlebar-style = transparent

# https://ghostty.org/docs/features/theme#built-in-themes (sourced from
# https://iterm2colorschemes.com/)
# Conditional form so mode 2031 reports the right light/dark scheme to tmux:
# https://github.com/ghostty-org/ghostty/discussions/8906
theme = light:TokyoNight Night,dark:TokyoNight Night
